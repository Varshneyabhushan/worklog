{
   "name": "worklog-web",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "tsc --noEmit && vite build && vite build --config vite.mcp.config.ts",
      "test": "vitest run",
      "typecheck": "tsc --noEmit",
      "format": "prettier --config ../server/prettierrc.json --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{ts,json,html}\""
   },
   "dependencies": {
      "@modelcontextprotocol/ext-apps": "^2.0.4",
      "@tanstack/react-query": "^5.105.3",
      "marked": "^18.1.3",
      "react": "^19.3.1",
      "react-dom": "^19.3.1"
   },
   "devDependencies": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.2.1",
      "prettier": "^3.9.10",
      "typescript": "^5.9.3",
      "vite": "^8.3.5",
      "vite-plugin-singlefile": "^2.3.4",
      "vitest": "^5.1.0"
   }
}
