# Copy to .env (git-ignored). Only src/config reads these.

# --- server
# Interface to bind; keep it on loopback, the service has no authentication.
WORKLOG_HOST=127.0.0.1
# Port for REST, /events and /mcp. Default 8765.
WORKLOG_PORT=8765
# pino level: trace | debug | info | warn | error. Default info.
LOG_LEVEL=info

# --- data
# Folder for worklog.db and the today.json snapshot. Default ~/.local/share/worklog.
# Keep it on the WSL disk: SQLite locking is unreliable on /mnt/c.
# WORKLOG_DATA_DIR=
# IANA time zone that decides which calendar day activity belongs to. Default Asia/Kolkata.
WORKLOG_TIME_ZONE=Asia/Kolkata

# --- reports (required)
# Folder that receives "<month> <year>/DD-MM-YYYY.md" day reports.
WORKLOG_REPORT_ROOT=/mnt/c/Users/<you>/Documents/notes/worklog
# Where export_backup writes the SQL dump. Default <WORKLOG_REPORT_ROOT>/db/worklog.sql.
# WORKLOG_BACKUP_PATH=

# --- snapshot
# How often today.json is rewritten with no changes, so meeting states and the date roll over. Milliseconds, default 60000.
# WORKLOG_SNAPSHOT_REFRESH_MS=60000
